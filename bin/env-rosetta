#!/usr/bin/env bash
# env-rosetta — orchestrator dispatcher
# Subcommands: provision | rollout | page | demo
set -euo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HERE"

cmd="${1:-help}"
shift || true

case "$cmd" in
  provision) exec python3 bin/provision.py "$@" ;;
  rollout)   exec python3 bin/rollout.py "$@" ;;
  page)      exec python3 bin/build_cards.py "$@" ;;
  demo)      exec python3 bin/demo.py "$@" ;;
  help|-h|--help|"")
    cat <<EOF
env-rosetta — same Wordle env, 4 RL frameworks, islo.dev sandboxes (May 2026 demo).

Subcommands:
  provision     spawn 3 islo sandboxes (Verifiers runs in-process), install deps, start servers, share ports.
                  Writes share URLs to cards/<framework>.json.
  rollout       write a scripted example transcript (not an LLM rollout) into cards/<framework>.json.
                  No model call, no network.
  page          rebuild env-rosetta-page/cards.json from cards/*.json.
  demo          offline walkthrough: placeholder cards plus the scripted example transcript (no network).
EOF
    ;;
  *) echo "unknown: $cmd" >&2; exit 2 ;;
esac
